# Copier ce fichier en .env
# Base PostgreSQL lancée avec Docker : docker compose up -d db (voir compose.yaml)
DATABASE_URL="postgresql://cloudops:cloudops@localhost:5433/cloudops?schema=public"

# Sans Docker (PostgreSQL installé sur le PC), utiliser plutôt :
# DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/cloudops?schema=public"

JWT_SECRET="changer-cette-valeur"
JWT_EXPIRES_IN="1d"
PORT=4000
