          <mxGeometry x="970" y="545" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="env" value="Fichier .env&lt;br&gt;(variables d'environnement)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="545" width="170" height="55" as="geometry" />
